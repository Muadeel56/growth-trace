# Postgres (used by docker-compose.yml and DATABASE_URL below)
POSTGRES_USER=growthtrace
POSTGRES_PASSWORD=changeme
POSTGRES_DB=growthtrace
# Host ports (change if these collide with other local services)
POSTGRES_PORT=5533
REDIS_PORT=6480

# Backend connection strings
DATABASE_URL=postgresql://growthtrace:changeme@localhost:5533/growthtrace
REDIS_URL=redis://localhost:6480

# GitHub OAuth App (register at https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App session signing (used for FR-1.4's own session, independent of GitHub token)
SESSION_SECRET=

# LLM / embeddings provider — Ollama (local), see docs/adr/0001-llm-embeddings-provider.md
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Frontend → backend origin. API_BASE_URL is read on the server (Server Components);
# NEXT_PUBLIC_API_BASE_URL is inlined for the browser. Playwright overrides both.
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
