{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["lychee"],
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.spec.ts", "e2e/fixtures/server.ts"],
      "project": ["*.{js,ts}", "e2e/**/*.ts"]
    },
    "packages/config": {
      "entry": ["*.config.js", "scripts/*.js", "test/**/*.test.ts"],
      "project": ["*.js", "eslint-rules/**/*.js", "scripts/**/*.js", "test/**/*.{js,ts}"]
    },
    "backend": {
      "entry": ["scripts/*.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "frontend": {
      "project": ["src/**/*.{ts,tsx}"],
      "entry": ["src/lib/api.ts"]
    },
    "packages/design-system": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
