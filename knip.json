{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.spec.ts"],
      "project": ["*.{js,ts}", "e2e/**/*.ts"]
    },
    "packages/config": {
      "project": ["*.js"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "backend": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "frontend": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreUnresolved": ["next"]
    },
    "packages/ui": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
