{
  "name": "growthtrace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:responsive": "playwright test --project=mobile --project=tablet --project=desktop --pass-with-no-tests",
    "clean:check": "knip",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:responsive && npm run clean:check"
  },
  "devDependencies": {
    "@growthtrace/config": "*",
    "@playwright/test": "^1.55.1",
    "eslint": "^9.36.0",
    "knip": "^5.64.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
